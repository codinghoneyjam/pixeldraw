{
  "dynamic_colors": {
    "hilt_light": "#E2E8F0",
    "hilt_dark": "#0F172A",
    "hilt_mid": "#94A3B8",
    "grip_light": "#F8FAFC",
    "grip_line": "#64748B",
    "visor_dark": "#0B0F19",
    "visor_inner": "#071526",
    "visor_edge": "#0284C7",
    "visor_glow": "#38BDF8A0",
    "blade_light": "#F8FAFC",
    "blade_core": "#CBD5E196",
    "blade_glint": "#FFFFFF96",
    "engrave_cyan": "#00E5FF",
    "engrave_shadow": "#000000",
    "engrave_white": "#FFFFFF"
  },
  "body": [
    { "desc": "pommel cap", "cmd": "rect", "box": [[116, 16], [164, 30]], "fill": "$hilt_light", "outline": "$hilt_dark", "width": 4 },
    { "desc": "pommel collar", "cmd": "rect", "box": [[124, 30], [156, 38]], "fill": "$hilt_mid", "outline": "$hilt_dark", "width": 3 },
    { "desc": "grip wrap row 0", "cmd": "rect", "box": [[126, 38], [154, 47]], "fill": "$grip_light", "outline": "$hilt_dark", "width": 3 },
    { "desc": "grip wrap row 1", "cmd": "rect", "box": [[126, 50], [154, 59]], "fill": "$grip_light", "outline": "$hilt_dark", "width": 3 },
    { "desc": "grip wrap row 2", "cmd": "rect", "box": [[126, 62], [154, 71]], "fill": "$grip_light", "outline": "$hilt_dark", "width": 3 },
    { "desc": "grip wrap row 3", "cmd": "rect", "box": [[126, 74], [154, 83]], "fill": "$grip_light", "outline": "$hilt_dark", "width": 3 },
    { "desc": "grip wrap row 4", "cmd": "rect", "box": [[126, 86], [154, 95]], "fill": "$grip_light", "outline": "$hilt_dark", "width": 3 },
    { "desc": "grip wrap seam 0", "cmd": "line", "points": [[128, 42], [152, 42]], "fill": "$grip_line", "width": 2 },
    { "desc": "grip wrap seam 1", "cmd": "line", "points": [[128, 54], [152, 54]], "fill": "$grip_line", "width": 2 },
    { "desc": "grip wrap seam 2", "cmd": "line", "points": [[128, 66], [152, 66]], "fill": "$grip_line", "width": 2 },
    { "desc": "grip wrap seam 3", "cmd": "line", "points": [[128, 78], [152, 78]], "fill": "$grip_line", "width": 2 },
    { "desc": "grip wrap seam 4", "cmd": "line", "points": [[128, 90], [152, 90]], "fill": "$grip_line", "width": 2 },
    { "desc": "crossguard plate", "cmd": "polygon",
      "points": [[84, 100], [196, 100], [204, 118], [184, 130], [96, 130], [76, 118]],
      "fill": "$hilt_light" },
    { "desc": "crossguard edge", "cmd": "line",
      "points": [[84, 100], [196, 100], [204, 118], [184, 130], [96, 130], [76, 118], [84, 100]],
      "fill": "$hilt_dark", "width": 4 },
    { "desc": "visor housing", "cmd": "rounded_rect", "box": [[92, 129], [188, 193]], "radius": 14, "fill": "$visor_dark", "outline": "#000000", "width": 4 },
    { "desc": "visor lens", "cmd": "rounded_rect", "box": [[98, 132], [182, 190]], "radius": 12, "fill": "$visor_inner", "outline": "$visor_edge", "width": 3 },
    { "desc": "visor highlight", "cmd": "line", "points": [[106, 136], [174, 136]], "fill": "$visor_glow", "width": 2 },
    { "desc": "blade plate", "cmd": "polygon",
      "points": [[94, 193], [186, 193], [176, 480], [140, 546], [104, 480]],
      "fill": "$blade_light" },
    { "desc": "blade edge", "cmd": "line",
      "points": [[94, 193], [186, 193], [176, 480], [140, 546], [104, 480], [94, 193]],
      "fill": "$hilt_dark", "width": 5 },
    { "desc": "blade fuller", "cmd": "line", "points": [[140, 195], [140, 510]], "fill": "$hilt_mid", "width": 4 },
    { "desc": "blade glint left", "cmd": "polygon",
      "points": [[96, 195], [140, 195], [140, 510], [106, 478]], "fill": "$blade_glint" },
    { "desc": "blade glint right", "cmd": "polygon",
      "points": [[140, 195], [184, 195], [174, 478], [140, 510]], "fill": "$blade_core" },
    { "desc": "engraving bracket open", "cmd": "text", "pen": [12, 172], "text": "[", "font": "monogram-240",
      "fill": "$engrave_cyan", "stroke_fill": "$engrave_shadow", "stroke_width": 8, "size": 240 },
    { "desc": "engraving letter l", "cmd": "text", "pen": [95, 172], "text": "l", "font": "monogram-240",
      "fill": "$engrave_white", "stroke_fill": "$engrave_shadow", "stroke_width": 9, "size": 240 },
    { "desc": "engraving bracket close", "cmd": "text", "pen": [178, 172], "text": "]", "font": "monogram-240",
      "fill": "$engrave_cyan", "stroke_fill": "$engrave_shadow", "stroke_width": 8, "size": 240 }
  ],
  "export": {
    "_comment": "Stored document is oversized to 288x576 so the canvas stays a 32 multiple; the viewport crops the top-left 280x560, which is exactly the legacy bake space. Command coordinates are therefore already in legacy space and must NOT be offset.",
    "canvas": { "width": 288, "height": 576 },
    "viewport": { "x": 0, "y": 0, "w": 280, "h": 560 }
  }
}
