{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/draw-tool/document_schema.v2.json",
  "title": "DrawToolDocument",
  "description": "Whole-document payload (format draw_tool.document): canvas + layers in stacking order (index 0 = bottom). Shared defs come from layer_schema.v2.json.",
  "type": "object",
  "required": ["schema_version", "format", "document_id", "canvas", "layers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "format": { "const": "draw_tool.document" },
    "document_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "maxLength": 128 },
    "canvas": { "$ref": "layer_schema.v2.json#/$defs/canvas" },
    "active_layer_id": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "layer_schema.v2.json#/$defs/layer" }
    }
  }
}
