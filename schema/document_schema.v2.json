{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/draw-tool/document_schema.v2.json",
  "title": "DrawToolDocument",
  "description": "Whole-document payload (format draw_tool.document): canvas + layers in stacking order (index 0 = bottom). Shared defs come from layer_schema.v2.json.",
  "type": "object",
  "required": ["schema_version", "format", "document_id", "canvas", "layers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "format": { "const": "draw_tool.document" },
    "document_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "maxLength": 128 },
    "canvas": { "$ref": "layer_schema.v2.json#/$defs/canvas" },
    "active_layer_id": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "layer_schema.v2.json#/$defs/layer" }
    },
    "atlas": {
      "type": "object",
      "description": "Optional authoring layout for atlas PNG export. Omitted by documents that have never saved an atlas layout.",
      "additionalProperties": false,
      "required": ["mode", "columns", "cell_w", "cell_h", "preset_all", "slots"],
      "properties": {
        "mode": { "enum": ["layers", "composed"] },
        "columns": { "type": "integer", "minimum": 1, "maximum": 16 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 16, "description": "Optional fixed row count; omitted rows grow to fit the cells." },
        "cell_w": { "type": "integer", "minimum": 1 },
        "cell_h": { "type": "integer", "minimum": 1 },
        "margin": { "type": "integer", "minimum": 0, "maximum": 4096, "default": 0 },
        "padding": { "type": "integer", "minimum": 0, "maximum": 4096, "default": 0 },
        "preset_all": { "type": "boolean" },
        "slots": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "layer_ids", "merged"],
            "properties": {
              "name": { "type": "string" },
              "layer_ids": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
              "merged": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
